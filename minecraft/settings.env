# EDITION: bedrock | java | java-geyser
#   bedrock      = Bedrock dedicated server (x86 only, emulated with box64 on the free ARM VM - slower)
#   java         = Java Edition (Paper), runs natively on ARM - fast
#   java-geyser  = Paper + Geyser + Floodgate: Java AND Bedrock players can join (recommended on ARM)
EDITION=java-geyser
# Bedrock version (empty = latest). Paper version (empty = latest, then kept).
BEDROCK_VERSION=
PAPER_VERSION=
# Ports: SERVER_PORT = Bedrock/Geyser UDP, JAVA_PORT = Java TCP
SERVER_PORT=19132
JAVA_PORT=25565
# Java heap in MB (empty = about 60% of the VM's RAM)
JAVA_RAM_MB=
# Java editions require you to accept the Minecraft EULA (https://aka.ms/MinecraftEULA): set true
EULA=true
# yes = run a light CPU load so Oracle doesn't reclaim an "idle" free VM
KEEPALIVE=yes
